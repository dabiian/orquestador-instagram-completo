  "bot_reply_templates": [
    {
      "id": "Q-MAIN",
      "label": "Standard valuation request",
      "trigger": "They ask for price, quote, procedure cost, valuation, package, or how much",
      "recommended": true,
      "comment": "¡Con gusto te orientamos! ✨ El precio depende del procedimiento y de la valoración, así que primero necesitamos unos datos rápidos:\n\n1️⃣ ¿Qué procedimiento te interesa? (Botox, hilos PDO, endolifting, rellenos, foxy eyes, párpados, nariz...)\n2️⃣ ¿Qué zona quieres tratar?\n3️⃣ ¿Tienes una fecha o evento próximo?\n4️⃣ ¿Es tu primera vez con medicina estética?\n\nCon eso la Dra. Deysi Torres te guía en una valoración gratuita.",
      "notes": [
        "No da precios públicamente",
        "Recolecta datos mínimos",
        "Termina en valoración gratuita",
        "No diagnostica"
      ]
    },
    {
      "id": "Q-SHORT",
      "label": "When they just say 'precio?'",
      "trigger": "Very short reply — 'precio?', 'cuánto vale?', 'costo?'",
      "recommended": false,
      "comment": "Depende del procedimiento y la zona ✨ La valoración con la Dra. Deysi Torres es gratuita. ¿Te interesa Botox, hilos PDO, rellenos, endolifting o aún no sabes cuál?",
      "notes": [
        "Breve",
        "No precio público",
        "Pregunta Q1 mínima",
        "Valoración gratuita"
      ]
    },
    {
      "id": "Q-URGENT",
      "label": "When they signal event urgency",
      "trigger": "Reply contains 'boda', 'viaje', 'grado', 'evento', 'urgente', 'lo antes posible'",
      "recommended": false,
      "comment": "Perfecto, si tienes evento próximo hay que revisar tiempos ✨ ¿Qué procedimiento o zona te interesa y para qué fecha lo necesitas? La Dra. Deysi Torres puede orientarte en valoración gratuita.",
      "notes": [
        "Activa contexto de fecha",
        "Pregunta tratamiento + timing",
        "No promete resultados",
        "Activa alerta URGENT"
      ]
    }
  ],
  "rules": {
    "bot_never_sends_price_publicly": true,
    "bot_collects_details_before_alert": true,
    "alert_priority": "QUOTE",
    "quote_alert_after_min_answers": [
      "Q1",
      "Q2"
    ],
    "wait_for_all_4_answers_required": false,
    "human_sends_final_quote_via_dm": true,
