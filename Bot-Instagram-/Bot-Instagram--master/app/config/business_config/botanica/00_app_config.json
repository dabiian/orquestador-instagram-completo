  "workflow": {
    "intro_comment_once_per_account": true,
    "reply_window_hours": 72,
    "service_request_priority_over_data_request": true,
    "price_request_priority_over_data_request": true,
    "alert_after_min_answers": [
      "Q1",
      "Q2"
    ],
    "human_takeover_stops_bot": true,
    "likes_only_mode_after_no_response": true,
    "dm_or_whatsapp_for_private_details": true,
    "never_make_guaranteed_results_claims": true,
    "never_pressure_with_fear_or_urgency": true
  },
