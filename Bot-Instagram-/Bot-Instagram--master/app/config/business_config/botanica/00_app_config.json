  "safety_limits": {
    "absolute_rules": {
      "intro_comment_per_account_lifetime_max": 1,
      "likes_or_loves_per_account_per_week_max": 3,
      "likes_or_loves_per_account_per_week_min_target": 1
    },
    "daily_limits": {
      "new_intro_comments_max": 12,
      "new_intro_comments_min_target": 6,
      "follows_max": 20,
      "follows_min_target": 8,
      "likes_loves_max": 35,
      "likes_loves_min_target": 15,
      "auto_replies_limit": null
    },
    "delays_seconds": {
      "between_intro_comments": {
        "min": 600,
        "max": 1200
      },
      "between_follows": {
        "min": 240,
        "max": 540
      },
      "between_likes": {
        "min": 90,
        "max": 240
      },
      "comment_to_auto_reply": {
        "min": 600,
        "max": 1800
      },
      "post_detected_to_intro_comment": {
        "min": 900,
        "max": 2700
      }
    },
    "content_safety_rules": [
      "No prometer resultados garantizados.",
      "No usar miedo, amenazas espirituales ni presión emocional.",
      "No pedir datos íntimos públicamente.",
      "Mover detalles sensibles a DM o WhatsApp.",
      "No diagnosticar salud, embarazo, enfermedad, muerte o temas legales.",
      "No afirmar poderes absolutos: usar lenguaje de orientación, consulta, trabajo espiritual o acompañamiento."
    ]
  }
