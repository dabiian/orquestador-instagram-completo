# Backend/API
# Use the same backend host for Task, AI, Account and Prospecting APIs unless
# you explicitly configure the *_API_URL variables below.
API_URL=http://localhost:8000/api/
SOCKET=ws://localhost:8000/ws/

# Optional per-service overrides
# TASK_API_URL=
# AI_API_URL=
# ACCOUNT_API_URL=
# PROSPECTING_API_URL=

# Instagram Selenium
SELENIUM_REMOTE_URL=

# Browser / runtime
PYTHONUNBUFFERED=1
TZ=America/Bogota
BOT_EXECUTOR=Bot_Instagram_LOCAL
# Same secret configured as INSTAGRAM_TASK_CLAIM_TOKEN on Django.
TASK_API_TOKEN=
USE_PROXY=False

# Optional SMTP alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_EMAIL_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Instagram prospect classifier / Self-Healer
SELF_HEALER_ENABLED=true
SELF_HEALER_ALLOW_AI=true
SELF_HEALER_MODEL=deepseek-chat
SELF_HEALER_PROJECT=instagram_bot
SELF_HEALER_DB_PATH=self_healer.db
SELF_HEALER_MAX_AI_CANDIDATES=5
SELF_HEALER_MAX_HTML_CHARS=120000
SELF_HEALER_CHUNK_SIZE_KB=50
SELF_HEALER_MAX_CHUNKS=5

# AI provider for Self-Healer (keep the real key out of source control)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Instagram navigation / HTTP 429 protection
# Minimum gap between direct profile/post navigations and cooldown after a 429.
INSTAGRAM_PROFILE_NAV_GAP_SECONDS=2.5
INSTAGRAM_429_COOLDOWN_SECONDS=90

# Instagram follow verification timeout (seconds).
# After the follow click is accepted, verification is bounded and never clicks again.
INSTAGRAM_FOLLOW_VERIFY_TIMEOUT_SECONDS=6
